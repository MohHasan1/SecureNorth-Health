# DATABASE_URI format depends on NODE_ENV (see src/payload.config.ts):
#   - dev/local (NODE_ENV unset or "development"): SQLite file
#       DATABASE_URI=file:./db.sqlite
#   - production (NODE_ENV=production): MongoDB connection string
#       DATABASE_URI=mongodb+srv://user:pass@cluster.mongodb.net/securenorth
DATABASE_URI=file:./db.sqlite

# Payload's own auth/session signing secret (any long random string for local dev)
PAYLOAD_SECRET=change-me-local-dev-secret

# 32-byte AES-256 key, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Stands in for a KMS-managed key — see DEMO.md for the talking point.
PATIENT_FIELD_ENCRYPTION_KEY=
