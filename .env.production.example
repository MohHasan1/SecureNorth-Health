# Used by `pnpm build` / `pnpm start` / `pnpm seed:prod` (NODE_ENV=production).
# payload.config.ts switches to the MongoDB adapter whenever NODE_ENV is
# "production" — see src/payload.config.ts.

# MongoDB connection string (Atlas, self-hosted, whatever you're pointing at)
DATABASE_URI=mongodb+srv://user:pass@cluster.mongodb.net/securenorth

# Use different values than local dev's .env — these are real production
# secrets, never reuse the sqlite-dev ones.
PAYLOAD_SECRET=
PATIENT_FIELD_ENCRYPTION_KEY=
